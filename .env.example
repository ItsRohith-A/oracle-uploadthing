# Authentication
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=your-secure-password-here
API_TOKEN=your-api-token-here

# OCI Object Storage Configuration
OCI_REGION=us-ashburn-1
OCI_BUCKET_NAME=your-bucket-name
OCI_NAMESPACE=your-namespace

# OCI Authentication Method
# Options: env_vars (recommended for Vercel), config_file (for local dev), instance_principal (for OCI compute)
OCI_AUTH_TYPE=env_vars

# For config_file auth type (local development):
# OCI_CONFIG_FILE_PATH=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT

# For env_vars auth type (recommended for Vercel):
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxx
OCI_USER_OCID=ocid1.user.oc1..xxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# Private key - paste the entire PEM content including headers
# For Vercel, add this as an environment variable with multi-line support
OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your-private-key-content-here
-----END PRIVATE KEY-----"
